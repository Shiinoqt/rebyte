# Rebyte — copiare in infra/.env e sostituire le password.
# infra/.env non va messo sotto version control.
#
#   cp infra/.env.example infra/.env
#   docker compose -f infra/docker-compose.yml up -d --build

# ══════════════════════════════════════════════════════════════════════════
# LETTO DA DOCKER COMPOSE
# ══════════════════════════════════════════════════════════════════════════

# ── MySQL — user_db, order_db, payment_db ─────────────────────────────────
# MYSQL_USER deve corrispondere all'utente nei GRANT di
# infra/mysql/init/01-schemas.sql (hardcoded a 'rebyte').
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=rebyte
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ── MongoDB — catalog_db, messaging_db ────────────────────────────────────
# Nessuna autenticazione in sviluppo: il replica set a nodo singolo girerebbe
# in keyfile mode, che complica il setup senza dare nulla in locale.
#
# ⚠️ MONGO_PORT deve restare 27017. Il membro del replica set è dichiarato
# "localhost:27017": mongod si riconosce come membro solo se la porta
# corrisponde a quella su cui ascolta nel container. Se un altro progetto
# occupa 27017, va fermato quello — le altre porte qui sotto invece si
# possono rimappare liberamente.
MONGO_PORT=27017

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
# REDIS_PASSWORD=change-me   # non usata in locale; richiede --requirepass nel compose

# ── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_USER=rebyte
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── order-service — offerte (Fase 3.1) ────────────────────────────────────
# Accorcia l'hold di un'offerta accettata: utile per far girare la folder B
# (scadenza via reconciliation sweep) della collection Postman Fase 3.1
# senza aspettare 24 ore.
# OFFER_HOLD_DURATION=PT2M

# ── Meilisearch ───────────────────────────────────────────────────────────
# La master key deve essere di almeno 16 byte.
MEILI_MASTER_KEY=change-me-almeno-16-byte
MEILI_ENV=development
MEILI_PORT=7700


# ══════════════════════════════════════════════════════════════════════════
# RIFERIMENTO PER I SERVIZI SPRING — non letto da compose
#
# I servizi girano sull'host (./mvnw -pl <module> spring-boot:run) e si
# collegano ai container via localhost. Questi sono i valori da mettere
# negli application.yml, scritti qui una volta sola.
# ══════════════════════════════════════════════════════════════════════════

# ── Porte dei servizi ─────────────────────────────────────────────────────
# Non fissate in docs/: sono la convenzione del progetto.
#   discovery-server   8761
#   api-gateway        8080
#   user-service       8081
#   catalog-service    8082
#   messaging-service  8083
#   order-service      8084
#   payment-service    8085
CATALOG_SERVICE_PORT=8082
# ORDER_SERVICE_PORT=8084
# PAYMENT_SERVICE_PORT=8085
#
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# ── MySQL (user / order / payment) ────────────────────────────────────────
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/user_db
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/order_db
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/payment_db
# ORDER_DB_JDBC_URL=jdbc:mysql://localhost:3306/order_db
# PAYMENT_DB_JDBC_URL=jdbc:mysql://localhost:3306/payment_db
# SPRING_DATASOURCE_USERNAME=rebyte
# SPRING_DATASOURCE_PASSWORD=change-me

# ── MongoDB (catalog / messaging) ─────────────────────────────────────────
# ⚠️ ?replicaSet=rs0 è obbligatorio (§2b): senza, il driver tratta il nodo
# come standalone e le transazioni dell'outbox falliscono.
# MONGO_URI=mongodb://localhost:27017/catalog_db?replicaSet=rs0
# SPRING_MONGODB_URI=mongodb://localhost:27017/messaging_db?replicaSet=rs0
#
# Opzione B (§2b): MongoDB Atlas al posto del container — è solo uno swap
# di questa riga con la connection string del cluster. Atlas è già un
# replica set, quindi il ?replicaSet non serve.
# SPRING_MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/catalog_db

# ── Redis / RabbitMQ / Meilisearch ────────────────────────────────────────
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=rebyte
# SPRING_RABBITMQ_PASSWORD=change-me
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=change-me-almeno-16-byte

# ── Profili (§2c identità) ────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=local-auth

# ── PayPal sandbox checkout (§3) ──────────────────────────────────────────
# Provide these to host-run payment-service; keep real secrets outside Git.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# CHECKOUT_RETURN_BASE_URL=https://your-app.example
# PAYPAL_WEBHOOK_URL=https://your-tunnel.example/payments/webhook

# ── AWS — Cognito (§2c) e S3/CloudFront (§2c media) ───────────────────────
# Chiavi di un IAM user limitato a s3:PutObject/GetObject/DeleteObject sul
# solo prefisso avatars/ del bucket media — niente ListBucket, niente
# accesso fuori dal prefisso. Mai le credenziali root.
# AWS_REGION=eu-south-1
# COGNITO_USER_POOL_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Media (D-33..D-39). MEDIA_BUCKET e MEDIA_DISTRIBUTION_DOMAIN non hanno
# default in user-service/application.yml *per contratto*: un deployment
# che li dimentica deve rifiutare di partire invece di servire link rotti.
# Non aggiungere default per "far partire" il servizio.
# Il bucket e privato (block-public-access ON) e si legge solo attraverso
# la distribuzione CloudFront con Origin Access Control (D-36).
# MEDIA_BUCKET=
# MEDIA_REGION=eu-south-1
# MEDIA_DISTRIBUTION_DOMAIN=xxxxxxxxxxxxxx.cloudfront.net
# MEDIA_AVATARS_PREFIX=avatars/

# Catalog: separate principal restricted to listings/ and software/.
# CATALOG_AWS_ACCESS_KEY_ID=
# CATALOG_AWS_SECRET_ACCESS_KEY=
# MEDIA_LISTINGS_PREFIX=listings/
# MEDIA_SOFTWARE_PREFIX=software/

# ── user-service — local-auth (Fase 5, D-04) ──────────────────────────────
# Indirizzo restituito dalla lookup email interna in local-auth: in sandbox
# SES deve essere una casella verificata. Per il test di bounce si usa
# bounce@simulator.amazonses.com (vedi docs/phase-05-live-runbook.md).
# LOCAL_AUTH_TEST_EMAIL=

# ── messaging-service — SES, email e realtime (Fase 5) ────────────────────
# Le chiavi MESSAGING_AWS_* appartengono solo all'IAM user
# rebyte-messaging-service (D-36): mai le AWS_* condivise. Il servizio
# rifiuta di partire se sono vuote.
# MESSAGING_AWS_ACCESS_KEY_ID=
# MESSAGING_AWS_SECRET_ACCESS_KEY=
# SES_REGION=eu-south-1
# SES_FROM_ADDRESS=no-reply@rebyte.tech
# SES_CONFIGURATION_SET=rebyte-transactional
# Lasciare false finché la coda SQS degli eventi SES (D-44) non esiste.
# SES_EVENTS_ENABLED=false
# SES_EVENTS_QUEUE_URL=
# Almeno 32 byte casuali, per esempio: openssl rand -base64 48
# MESSAGING_UNSUBSCRIBE_SECRET=
# MESSAGING_WEB_BASE_URL=http://localhost:4200
# MESSAGING_PUBLIC_API_URL=http://localhost:8080
# MESSAGING_WS_ALLOWED_ORIGINS=http://localhost:4200
# MESSAGING_EMAIL_NEW_MESSAGE_WINDOW=PT15M
# MESSAGING_SES_MIN_SEND_INTERVAL_MS=1100

# ── Phase 6 web client ────────────────────────────────────────────────────
# Non-secret identifiers only. Uncomment in infra/.env to run the whole stack
# on the real Cognito pool instead of the local-auth token minter.
# REBYTE_AUTH_PROFILE=cognito
# COGNITO_USER_POOL_ID=eu-south-1_WPMqs7BW8
# AWS_REGION=eu-south-1
# One origin list feeds both the gateway CORS and the messaging WebSocket origins.
# SPA_ALLOWED_ORIGINS=http://localhost:4200
# CHECKOUT_RETURN_BASE_URL=http://localhost:4200
