# Copy privately to infra/.env.demo. Never commit resolved values or Compose output.
# JSON is used as valid YAML so the checker needs no YAML dependency.
# DEMO_RESOURCE_ID: inspected backend Coolify UUID; owns the precreated private network and four stable volumes.
# GHCR_NAMESPACE: ghcr.io/<owner>/<repo>; DEMO_IMAGE_TAG: reviewed immutable 40-character GitHub release SHA.
# GATEWAY_TRUSTED_PROXIES: single-quoted exact measured peer regex, for example ^10\.0\.1\.6$.
# CATALOG_MONGO_URI / MESSAGING_MONGO_URI: private SRV URIs for catalog_demo / messaging_demo with separate users.
# USER/CATALOG/MESSAGING_AWS_*: separate dedicated demo IAM keys, never dev or setup keys.
# All private values intentionally empty. Use strong unique database/broker/search secrets.
# MESSAGING_UNSUBSCRIBE_SECRET must contain at least 32 bytes. Shell-style single quotes preserve $ and backslashes.
# MEDIA_DISTRIBUTION_DOMAIN is the bare CloudFront domain, without https://.
AWS_REGION=eu-south-1
CATALOG_AWS_ACCESS_KEY_ID=
CATALOG_AWS_SECRET_ACCESS_KEY=
CATALOG_MONGO_URI=
CHECKOUT_RETURN_BASE_URL=https://rebyte.tech
COGNITO_USER_POOL_ID=
COOLIFY_PROXY_NETWORK=coolify
DEMO_IMAGE_TAG=
DEMO_RESOURCE_ID=
GATEWAY_TRUSTED_PROXIES=
GHCR_NAMESPACE=
MEDIA_BUCKET=
MEDIA_DISTRIBUTION_DOMAIN=
MEILI_MASTER_KEY=
MESSAGING_AWS_ACCESS_KEY_ID=
MESSAGING_AWS_SECRET_ACCESS_KEY=
MESSAGING_MONGO_URI=
MESSAGING_PUBLIC_API_URL=https://rebyte.tech
MESSAGING_UNSUBSCRIBE_SECRET=
MESSAGING_WEB_BASE_URL=https://rebyte.tech
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RABBITMQ_PASSWORD=
RABBITMQ_USER=
REDIS_PASSWORD=
SES_CONFIGURATION_SET=
SES_EVENTS_QUEUE_URL=
SES_FROM_ADDRESS=
SPA_ALLOWED_ORIGINS=https://rebyte.tech
USER_AWS_ACCESS_KEY_ID=
USER_AWS_SECRET_ACCESS_KEY=
