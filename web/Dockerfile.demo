FROM nginx:1.30.6-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5

COPY browser/ /usr/share/nginx/html/
COPY config.demo.json /usr/share/nginx/html/config.json
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf

RUN test -s /usr/share/nginx/html/index.html && test -s /usr/share/nginx/html/config.json
